$(eval $(call addlib_s,libmana,$(CONFIG_LIBMANA)))

CINCLUDES-$(CONFIG_LIBMANA) += -I$(LIBMANA_BASE)/include
CXXINCLUDES-$(CONFIG_LIBMANA) += -I$(LIBMANA_BASE)/include

LIBMANA_SRCS-y += $(LIBMANA_BASE)/src/mana.c
LIBMANA_SRCS-y += $(LIBMANA_BASE)/src/pci.c
LIBMANA_SRCS-y += $(LIBMANA_BASE)/src/gdma.c
LIBMANA_SRCS-y += $(LIBMANA_BASE)/src/control.c
LIBMANA_SRCS-y += $(LIBMANA_BASE)/src/data_queue.c
LIBMANA_SRCS-y += $(LIBMANA_BASE)/src/tx.c
LIBMANA_SRCS-y += $(LIBMANA_BASE)/src/rx.c
LIBMANA_SRCS-y += $(LIBMANA_BASE)/src/netdev.c
LIBMANA_SRCS-y += $(LIBMANA_BASE)/src/platform_unikraft.c
